{%- comment -%}
  Cole em: Loja virtual > Temas > Editar código > layout/password.liquid, logo depois de <head>.
  Só é necessário com checkout.mode = "password" (loja de desenvolvimento com senha).
  Guarda o endereço do checkout que o site enviou em ?next=... para a página inicial usar depois da senha.
{%- endcomment -%}
<script>
  (function () {
    try {
      var next = new URLSearchParams(location.search).get("next");
      if (next && next.indexOf(location.origin + "/") === 0) {
        sessionStorage.setItem("pendingCheckout", JSON.stringify({ u: next, t: Date.now() }));
      }
    } catch (e) {}
  })();
</script>
